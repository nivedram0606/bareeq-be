NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection, e.g. postgresql://postgres:postgres@127.0.0.1:5432/bareeq
DATABASE_URL=

# Direct connection for migrations (optional: defaults to DATABASE_URL)
DIRECT_DATABASE_URL=

# Optional SSL mode: 'require', 'prefer', 'disable'. (Auto-detected for remote hosts)
# DATABASE_SSL=require

# Secret for signing session tokens: 32+ random characters (openssl rand -base64 48).
# Required in production. If blank elsewhere, a random secret is generated at startup
# (everyone is signed out whenever the API restarts).
JWT_SECRET=
# How long a sign-in lasts, in hours (default 12)
# SESSION_TTL_HOURS=12

# Swagger UI at /api/docs and the OpenAPI spec at /api/v1/openapi.json (default true)
# API_DOCS=true

# Optional: requests per minute per client IP (raise if all staff share one public IP)
RATE_LIMIT_PER_MINUTE=300

# First admin credentials for pnpm db:seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-please
