NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
# Remote server / Supabase transaction pooler (port 6543) or direct connection (port 5432)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.exziyltgjvhzeqmfitxe.supabase.co:5432/postgres
DATABASE_URL=

# Direct connection for migrations (optional: defaults to DATABASE_URL if left blank)
DIRECT_DATABASE_URL=

# Optional SSL mode: 'require', 'prefer', 'disable'. (Auto-detected for remote hosts)
# DATABASE_SSL=require

# Supabase Auth & Storage API
# Example: https://exziyltgjvhzeqmfitxe.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: automatically derived from SUPABASE_URL if left unset
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=

# Optional: requests per minute per client IP (raise if all staff share one public IP)
RATE_LIMIT_PER_MINUTE=300

# First admin credentials for pnpm db:seed
SEED_ADMIN_EMAIL=admin@bareeq.test
SEED_ADMIN_PASSWORD=Bareeq-BV-y4k1Tkjg8
